# Environment / secrets
.env
.env.*
backend/.env
frontend/.env.local
*.env

# Infra parameters with secrets (contains API keys — use main.parameters.json.example instead)
infra/main.parameters.json
# Temporary ACI YAML — generated by deploy-aci-temp.ps1, contains secrets
infra/aci-temp.yaml

# Claude Code runtime config (settings, session data, audit logs)
.claude/

# Git worktrees (isolated feature branches)
.worktrees/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/

# Node / Next.js
node_modules/
.next/
out/

# Database
*.db
*.sqlite

# Runtime state (feed_manager.py's delta-ingest store, default path when
# FEED_DELTA_DIR isn't set -- see feed_manager.py:_delta_dir())
backend/data/

# Certificates and keys
*.key
*.pem
*.crt
*.pfx
*.p12

# OS
.DS_Store
Thumbs.db