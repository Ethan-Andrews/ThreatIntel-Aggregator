# Backend environment variables
# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored — never commit the real file.

# ── Auth mode ─────────────────────────────────────────────────────────────────
# Two mutually exclusive modes, selected automatically by whether
# AZURE_AD_TENANT_ID is set -- there is no separate flag to keep in sync.
#
# Entra mode (fill in the AZURE_AD_* block below): SSO via Microsoft Entra ID,
# per-user roles, first login becomes admin.
#
# Local mode (leave AZURE_AD_TENANT_ID unset, set LOCAL_API_KEY instead): a
# single shared key that grants admin access. No Azure dependency at all.

# ── Microsoft Entra ID (Azure AD) — Entra mode ────────────────────────────────
# Create an App Registration at https://portal.azure.com > Microsoft Entra ID > App registrations
# Add redirect URI: http://<FRONTEND_HOST>:3000/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=

# ── Local API key — local mode (only used when AZURE_AD_TENANT_ID is unset) ───
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LOCAL_API_KEY=

# ── App JWT signing key ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── NextAuth session key (frontend uses this) ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NEXTAUTH_SECRET=

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one provider: "anthropic" or "azure"
AI_PROVIDER=anthropic

# Anthropic (direct)
ANTHROPIC_API_KEY=

# Azure AI Foundry (alternative)
AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
AZURE_FOUNDRY_DEPLOYMENT=claude-haiku-4-5
AZURE_FOUNDRY_API_VERSION=2025-05-01
AZURE_FOUNDRY_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to http://localhost:3000 if not set.
ALLOWED_ORIGINS=http://localhost:3000
