# Copy to .env.local and fill in.
# frontend/.env.local is gitignored — never commit the real file.

# Backend URL as seen by the browser (client-side).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Entra ID mode only — leave unset for local API-key auth ────────────────
# Backend URL as seen by the Next.js server itself (server-side, used by the
# NextAuth callback and token-refresh routes).
# BACKEND_URL=http://localhost:8000
# AZURE_AD_CLIENT_ID=
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_SECRET=
# NEXTAUTH_SECRET=
